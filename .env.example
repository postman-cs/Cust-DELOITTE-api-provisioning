# ─────────────────────────────────────────────────────────
# API Publishing + Partner Workspace Provisioning
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Postman API ──────────────────────────────────────────
POSTMAN_API_KEY=PMAK-replace-me
POSTMAN_API_BASE_URL=https://api.getpostman.com

# ── Golden Workspace ─────────────────────────────────────
POSTMAN_GOLDEN_WORKSPACE_ID=replace-me-with-workspace-uid

# ── Service ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ── Auth / RBAC (Entra ID / OIDC) ───────────────────────
AUTH_ENABLED=false
AUTH_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
AUTH_AUDIENCE=api://deloitte-api-provisioning
AUTH_JWKS_URI=https://login.microsoftonline.com/{tenant}/discovery/v2.0/keys

# ── Database (audit log persistence) ─────────────────────
# For production use Postgres / CosmosDB; for local dev, SQLite.
DATABASE_URL=sqlite://./data/audit.db

# ── Policy overrides (optional — defaults come from config) ─
# POLICY_CONFIG_PATH=./config/policy.json

# ── Use mock Postman client instead of real API ──────────
USE_MOCK_POSTMAN_CLIENT=true
