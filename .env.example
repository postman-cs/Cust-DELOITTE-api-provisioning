# ─────────────────────────────────────────────────────────
# API Provisioning Platform — Configuration
#
# Copy this file to  service/.env  and fill in YOUR values.
#   cp .env.example service/.env
#
# The demo UI reads all its config from the backend's
# GET /config endpoint, so this is the ONLY file you
# need to edit.  Nothing is hardcoded in the HTML.
#
# NEVER commit service/.env to version control.
# ─────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════
# 1. POSTMAN API
# ═══════════════════════════════════════════════════════════
# Get your key at: https://go.postman.co/settings/me/api-keys
POSTMAN_API_KEY=PMAK-replace-me
POSTMAN_API_BASE_URL=https://api.getpostman.com

# ═══════════════════════════════════════════════════════════
# 2. WORKSPACES
# ═══════════════════════════════════════════════════════════
# Golden workspace = source of truth (collections, envs, specs live here)
POSTMAN_GOLDEN_WORKSPACE_ID=replace-me-with-workspace-uid
POSTMAN_GOLDEN_WORKSPACE_NAME=MyGoldenWorkspace

# Target workspaces — one per source environment (Step 7).
# Each source env (AWS, Azure, On-Prem) provisions into its
# own dedicated partner workspace.
TARGET_WS_AWS_ID=replace-me
TARGET_WS_AWS_NAME=TargetAWS
TARGET_WS_AZURE_ID=replace-me
TARGET_WS_AZURE_NAME=TargetAzure
TARGET_WS_ONPREM_ID=replace-me
TARGET_WS_ONPREM_NAME=TargetOnPrem

# ═══════════════════════════════════════════════════════════
# 3. DEMO BRANDING
# ═══════════════════════════════════════════════════════════
# These values are used throughout the demo UI and API calls.
# Change them to match YOUR org and partner.
ADMIN_ORG_NAME=Deloitte
ADMIN_ORG_DOMAIN=deloitte.com
PARTNER_NAME=Coca-Cola UK
PARTNER_DOMAIN=coca-cola.com
COMPETITOR_DOMAIN=pepsi.com

# ═══════════════════════════════════════════════════════════
# 4. SERVICE
# ═══════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ═══════════════════════════════════════════════════════════
# 5. AUTH (Entra ID / Azure AD / OIDC)
# ═══════════════════════════════════════════════════════════
# Set AUTH_ENABLED=true for production with real JWT validation.
# In dev mode (false), all requests get a default admin user.
AUTH_ENABLED=false
# AUTH_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# AUTH_AUDIENCE=api://your-app-registration
# AUTH_JWKS_URI=https://login.microsoftonline.com/{tenant}/discovery/v2.0/keys

# ═══════════════════════════════════════════════════════════
# 6. MOCK MODE
# ═══════════════════════════════════════════════════════════
# true  = In-memory mock (no API key needed, instant, great for dev)
# false = Real Postman API calls (requires POSTMAN_API_KEY)
#
# NOTE: Even in mock mode, Step 7 (Live Cross-Workspace Provisioning)
# uses the real Postman API if POSTMAN_API_KEY is set.
USE_MOCK_POSTMAN_CLIENT=true

# ═══════════════════════════════════════════════════════════
# 7. ADVANCED (optional)
# ═══════════════════════════════════════════════════════════
# CORS: comma-separated allowed origins (only enforced when NODE_ENV=production)
# CORS_ALLOWED_ORIGINS=https://your-demo-ui.com,https://localhost:8080
# DATABASE_URL=sqlite://./data/audit.db
# POLICY_CONFIG_PATH=./config/policy.json
# COMPLIANCE_CONFIG_PATH=./config/compliance.json
# GITHUB_SPEC_URL=https://raw.githubusercontent.com/your-org/your-repo/main/api/openapi.yaml
